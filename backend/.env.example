# =====================================================================
# Everett Hotel - Backend Environment Configuration
# Copy this file to `.env` and fill in real values. NEVER commit .env.
# =====================================================================

# --- Server ---
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000/api

# --- Database (MariaDB / MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=everett_hotel
DB_USER=root
DB_PASSWORD=

# --- Authentication (MANDATORY - server will refuse to start without these) ---
# Each secret MUST be >= 32 characters, and JWT_SECRET / JWT_REFRESH_SECRET
# MUST be distinct from each other. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=
COOKIE_DOMAIN=
# Comma-separated list of allowed frontend origins (required when NODE_ENV=production)
ALLOWED_ORIGINS=http://localhost:5000

# --- Frontend ---
FRONTEND_URL=http://localhost:5000/frontend
ADMIN_URL=http://localhost:5000/frontend

# --- SMTP (email verification, password reset, invoices) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=yoursecretapppassword
SMTP_FROM=Everett Hotel <you@example.com>

# --- File uploads ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# --- Rate limiting (per-IP) ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# --- Payments (placeholders - configure later) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- M-Pesa (placeholders - configure later) ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=

# --- SMS (placeholders - configure later) ---
SMS_PROVIDER=
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
